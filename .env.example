WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io

# Deployer wallet, funded with test WBT. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Both default to the deployer address when left empty.
INTENT_SIGNER_ADDRESS=
KEEPER_ADDRESS=

# Leave DATABASE_URL empty to use embedded Postgres in apps/api/data.
# With docker compose: postgres://settlekit:settlekit@localhost:5432/settlekit
DATABASE_URL=
PORT=4000
