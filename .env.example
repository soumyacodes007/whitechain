WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io

# Deployer wallet, funded with test WBT. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Both default to the deployer address when left empty.
INTENT_SIGNER_ADDRESS=
KEEPER_ADDRESS=

# Signs intents, and sends refunds, gasless payments and renewals. Both default to the deployer key.
INTENT_SIGNER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=

# Leave DATABASE_URL empty to use embedded Postgres in apps/api/data.
# With docker compose: postgres://settlekit:settlekit@localhost:55433/settlekit
DATABASE_URL=
PORT=4000

# Web: how the server and the customer's browser each reach the API.
API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000

# Set by apps/api/scripts/live-payment.ts and live-flows.ts.
SETTLEKIT_SECRET_KEY=
CUSTOMER_PRIVATE_KEY=
GASLESS_PRIVATE_KEY=

# Optional. Without a Resend key, emails are recorded in the dashboard's email log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=
